# Copier ce fichier en .env (jamais versionné) et renseigner les valeurs.

# Obligatoire. Adresse de la base ; commence par mongodb:// ou mongodb+srv://
MONGODB_URI=

# Obligatoire. Secret de signature des jetons ; 32 caractères au moins
JWT_SECRET=

# Facultative, défaut 4000 (variable absente ou laissée vide). Entier de 1 à 65535
PORT=

# Facultative, défaut development. development ou production
NODE_ENV=

# Facultative, défaut 8h. Nombre suivi de s, m, h ou d ; durée strictement positive et de 8 heures au plus
JWT_EXPIRES_IN=

# Facultative, défaut vide (aucune origine croisée). Origines séparées par des virgules ; chacune avec schéma et hôte, sans chemin
CORS_ORIGINS=

# Commande « npm run seed:admin --workspace=api » seulement : à placer dans .env le temps de la commande, puis à retirer. L'API ne les lit jamais.
# ADMIN_EMAIL : email valide. ADMIN_PASSWORD : 12 caractères au moins
ADMIN_EMAIL=
ADMIN_PASSWORD=
