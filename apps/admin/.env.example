# Obligatoire. Adresse de l'API, côté serveur seulement.
# Jamais exposée au navigateur : aucune variable NEXT_PUBLIC_* n'est utilisée.
API_URL=

# Facultative (recommandée en production). Secret partagé avec l'API (même valeur que son INTERNAL_API_SECRET), côté serveur seulement.
# Permet à l'API de compter sa limite de fréquence par visiteur et non par serveur. Absente : l'adresse du visiteur n'est pas transmise.
INTERNAL_API_SECRET=
